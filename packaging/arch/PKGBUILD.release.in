# RELEASE TEMPLATE — replace placeholders with REAL owner/version/checksum.
# Not valid for publication until all placeholders are resolved.
pkgname=bandhop
pkgver=@VERSION@
pkgrel=1
pkgdesc='Keyboard-driven terminal internet radio for Linux, written in Rust'
arch=('x86_64')
url='https://github.com/@GITHUB_OWNER@/bandhop'
license=('MIT' 'Apache-2.0')
depends=('mpv')
optdepends=('libnotify: desktop notifications' 'systemd: optional user daemon')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/@GITHUB_OWNER@/bandhop/releases/download/v${pkgver}/bandhop-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --offline
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo test --locked --offline
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/bandhop "${pkgdir}/usr/bin/bandhop"
  install -Dm644 packaging/arch/bandhop.service "${pkgdir}/usr/lib/systemd/user/bandhop.service"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/bandhop/README.md"
  install -Dm644 man/bandhop.1 "${pkgdir}/usr/share/man/man1/bandhop.1"
  install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/bandhop/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "${pkgdir}/usr/share/licenses/bandhop/LICENSE-APACHE"
}
